+/* Smash Online: scene class for the idle-game logic in ftport.c (port_solo_poll): 1 intro movies, 2 title and attract demo,
+ * 3 VS character select, 4 other menus, 0 anything else (matches, results, 1P). Only classes 1 to 4 may ever be left by a guest request. */
+s32 portSCManagerSceneClass(void)
+{
+	s32 s = gSCManagerSceneData.scene_curr;
+	if (s == nSCKindPlayersVS) return 3;
+	if (s >= nSCKindOpeningRoom && s <= nSCKindOpeningNewcomers) return 1;
+#if defined(REGION_US)
+	if (s == nSCKindStartup) return 1;
+#endif
+	if (s == nSCKindTitle || s == nSCKindAutoDemo) return 2;
+	if (s == nSCKindModeSelect || s == nSCKindVSMode || s == nSCKindVSOptions) return 4;
+	return 0;
+}
+
+/* Jump to the opening (to_css == 0) or the VS character select, the same way the console reset does (sticky target, audio
+ * wind-down, task manager ends the scene at the frame boundary). */
+void portSCManagerRequestJump(s32 to_css)
+{
+	extern void func_800266A0_272A0(void);
+	if (gSCManagerSceneData.scene_curr == nSCKindAutoDemo) gSCManagerSceneData.is_reset = TRUE; /* leave the demo match like a reset does */
+	sPortResetTarget = to_css ? nSCKindPlayersVS : nSCKindOpeningRoom;
+	sPortResetPending = TRUE;
+	func_800266A0_272A0();
+	gSCManagerSceneData.scene_prev = sPortResetTarget;
+	gSCManagerSceneData.scene_curr = sPortResetTarget;
+	syTaskmanSetLoadScene();
+}
+
 /* If a reset is pending: re-apply the target scene (undoing any scene_curr
  * writes a nested manager made since the request), clear the pending flag,
  * and return TRUE so nested managers know to unwind to scManagerRunLoop. */
