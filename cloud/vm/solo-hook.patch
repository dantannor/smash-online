+/* Smash Online "Play vs CPU": the requesting player gets a fighter if it has none, every port that is not a connected guest (up to
+ * cpu_count of them) becomes a CPU with a random original fighter, and the match starts as if Start had been pressed. */
+static void mnPlayersVSPortSolo(s32 req, s32 connected_mask, s32 cpu_count)
+{
+	s32 i, fk, made = 0, used = 0;
+	if (sMNPlayersVSIsStart != FALSE) return;
+	if (sMNPlayersVSSlots[req].is_fighter_selected == FALSE || sMNPlayersVSSlots[req].pkind != nFTPlayerKindMan)
+	{
+		fk = syUtilsRandTimeUCharRange(nFTKindPlayableEnd + 1);
+		sMNPlayersVSSlots[req].fkind = fk;
+		sMNPlayersVSSlots[req].costume = 0;
+		sMNPlayersVSSlots[req].pkind = nFTPlayerKindMan;
+		sMNPlayersVSSlots[req].is_selected = TRUE;
+		sMNPlayersVSSlots[req].is_fighter_selected = TRUE;
+		sMNPlayersVSSlots[req].is_status_selected = FALSE;
+		mnPlayersVSMakeFighter(sMNPlayersVSSlots[req].player, req, fk, 0);
+	}
+	used |= 1 << sMNPlayersVSSlots[req].fkind;
+	for (i = 0; i < GMCOMMON_PLAYERS_MAX && made < cpu_count; i++)
+	{
+		if (i == req || ((connected_mask >> i) & 1)) continue;
+		do { fk = syUtilsRandTimeUCharRange(nFTKindPlayableEnd + 1); } while (((used >> fk) & 1) && used != ((1 << (nFTKindPlayableEnd + 1)) - 1));
+		used |= 1 << fk;
+		sMNPlayersVSSlots[i].pkind = nFTPlayerKindCom;
+		sMNPlayersVSSlots[i].fkind = fk;
+		sMNPlayersVSSlots[i].costume = mnPlayersVSGetFreeCostume(fk, i);
+		sMNPlayersVSSlots[i].cpu_level = 4;
+		sMNPlayersVSSlots[i].holder_player = GMCOMMON_PLAYERS_MAX;
+		sMNPlayersVSSlots[i].is_selected = TRUE;
+		sMNPlayersVSSlots[i].is_fighter_selected = TRUE;
+		if (sMNPlayersVSSlots[i].type_button != NULL) mnPlayersVSUpdatePlayerKindSelect(sMNPlayersVSSlots[i].type_button, i, nFTPlayerKindCom);
+		made++;
+	}
+	if (made == 0 || mnPlayersVSCheckReady() == FALSE) return;
+	func_800269C0_275C0(nSYAudioVoicePublicCheer);
+	mnPlayersVSSetIdlePlayerNotAll();
+	sMNPlayersVSStartProceedWait = 30;
+	sMNPlayersVSIsStart = TRUE;
+	mnPlayersVSPauseSlotProcesses();
+}
