{
  "name": "smash-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test --test-timeout=30000 $(find . -type f -name '*.test.js' -not -path './node_modules/*' -not -path './cloud/*' -print)",
    "cloud:build": "node cloud/build-assets.mjs",
    "cloud:deploy": "node cloud/build-assets.mjs && wrangler deploy --config cloud/wrangler.toml",
    "test:cloud": "node --test --test-timeout=120000 cloud/worker.test.js"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "wrangler": "^4.149.0",
    "ws": "8.22.0"
  }
}
